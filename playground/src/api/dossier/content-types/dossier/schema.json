      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "translate": {
          "translate": "translate"
        },
        "i18n": {
          "localized": true
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "translate": {
          "translate": "translate"
        },
        "i18n": {
          "localized": true
        }
      }
    },
    "topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "inversedBy": "dossiers",
      "pluginOptions": {
        "translate": {
          "translate": "translate"
        }
      }
    },
    "featuredTopics": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::topic.topic",
      "mappedBy": "featuredDossier",
      "pluginOptions": {
        "translate": {
          "translate": "translate"
        }
      }
    }
  }
