{
  "kind": "collectionType",
  "collectionName": "dossiers",
  "info": {
    "singularName": "dossier",
    "pluralName": "dossiers",
    "displayName": "Dossier",
    "description": "Localized, draft & publish. Forms a genuine dependency cycle with Topic: dossier.topics owns one edge, topic.featuredDossier owns the other."
